# Base URL of the backend API, including the /api prefix.
#
# Optional in development: when unset, the app derives the address from the
# Expo dev server's host (the machine running `npx expo start`), which is
# usually where the backend runs too. Set it when the backend is elsewhere.
#
# On a physical device or emulator, "localhost" refers to the device itself,
# not the computer running the backend - so this must point at an address
# the device can actually reach:
#
#   Physical phone on the same Wi-Fi as this computer:
#     # EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api
#
#   Android emulator (reaches the host machine via a special alias):
#     EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api
#
#   iOS simulator only (shares the Mac's network namespace):
#     EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
#
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle when the dev
# server starts, so restart `npx expo start` after changing this file.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api

# Google AdMob ad units (see src/lib/admob.ts).
#
# Development builds ALWAYS use Google's test units, whatever is set here -
# tapping your own live ads can get the AdMob account suspended. Release
# builds use these; a format with no unit set is simply not shown.
#
# The AdMob APP ids (the ones with "~") are not set here: they are compiled
# into the native app from the react-native-google-mobile-ads entry in
# app.json, which ships with Google's test app ids until you replace them.
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
#
# Force test units in a release build (a preview APK for testers):
# EXPO_PUBLIC_ADMOB_USE_TEST_IDS=true
