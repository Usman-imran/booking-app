# Base URL of the backend API, including the /api prefix.
#
# On a physical device or emulator, "localhost" refers to the device itself,
# not the computer running the backend - so this must point at an address
# the device can actually reach:
#
#   Physical phone on the same Wi-Fi as this computer:
#     EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api
#
#   Android emulator (reaches the host machine via a special alias):
#     EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api
#
#   iOS simulator only (shares the Mac's network namespace):
#     EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
#
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle when the dev
# server starts, so restart `npx expo start` after changing this file.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api
