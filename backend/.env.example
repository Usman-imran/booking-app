# Server
PORT=5000
NODE_ENV=development

# CORS
# Comma-separated list of allowed origins. The Capacitor Android app serves its
# web assets from https://localhost, so that origin must be present for the
# mobile build to reach this API.
CORS_ORIGIN=http://localhost:5173,https://localhost,http://localhost

# PostgreSQL
# Provide either DATABASE_URL, or the individual PG* values below.
# DATABASE_URL is also what `node-pg-migrate` (npm run migrate:*) uses.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_booking

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=order_booking

# Auth
# Generate your own secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this example value outside local development.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=12h
