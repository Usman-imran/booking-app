# Server
PORT=5000
NODE_ENV=development

# CORS - only matters for browser clients (e.g. the mobile app's web build
# served by `npx expo start --web` on port 8081). Native apps send no Origin
# header and are never blocked.
CORS_ORIGIN=http://localhost:8081

# PostgreSQL
# Provide either DATABASE_URL, or the individual PG* values below.
# DATABASE_URL is also what `node-pg-migrate` (npm run migrate:*) uses.
# A hosted database (Render, Neon, Supabase, ...) requires TLS - append
# ?sslmode=verify-full to the URL or the server drops the connection
# (which shows up as a bare ECONNRESET):
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=verify-full
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_booking

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=order_booking

# Auth
# Generate your own secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this example value outside local development.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=12h
