# Base URL of the backend API, including the /api prefix.
#
# Browser development (backend on the same machine):
#   VITE_API_BASE_URL=http://localhost:5000/api
#
# Android device / emulator: localhost means the PHONE, not your computer, so
# the mobile build must point at an address the device can actually reach —
# your machine's LAN IP while both are on the same Wi-Fi:
#   VITE_API_BASE_URL=http://192.168.1.20:5000/api
# (Android emulator only: http://10.0.2.2:5000/api reaches the host machine.)
#
# Vite inlines this at BUILD time, so re-run `npm run cap:sync` after changing it.
VITE_API_BASE_URL=http://localhost:5000/api
